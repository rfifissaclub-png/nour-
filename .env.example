# Supabase PostgreSQL: transaction pooler for runtime (port 6543, pgbouncer).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase session-mode pooler for Prisma Migrate (port 5432, no pgbouncer).
# Use the pooler host (not db.<ref>.supabase.co) for IPv4 compatibility.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

APP_ORIGIN="http://localhost:3000"
AUTH_SECRET=""
TRUSTED_IP_HEADER=""

# The application uses SUPABASE_URL on the server for private Storage REST calls.
# NEXT_PUBLIC_SUPABASE_URL is optional and is not currently used by browser code.
SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="nour-resources"

# Protects GET /api/keep-alive. Use a different random secret from BACKUP_CRON_SECRET.
CRON_SECRET=""

# Existing backup worker and private Excel backup configuration.
BACKUP_CRON_SECRET=""
BACKUP_STORAGE_BUCKET=""
BACKUP_RETENTION_DAYS="365"

# Optional Google Sheets synchronization.
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Optional Admin password recovery email (Resend).
RESEND_API_KEY=""
RECOVERY_EMAIL_FROM="NOUR <securite@votre-domaine.ma>"

# Optional server-side account creation scripts; do not set these in Vercel.
ACCOUNT_CODE=""
ACCOUNT_NAME=""
ACCOUNT_ROLE=""
ACCOUNT_PHONE=""
ACCOUNT_PIN=""
ACCOUNT_PASSWORD=""
